{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile with gamified progress, learning streak, course history, and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "avatar": { "type": "string", "maxLength": 500 },
        "xp": { "type": "number" },
        "level": { "type": "string", "maxLength": 50 },
        "streak": { "type": "number" },
        "streakActiveToday": { "type": "boolean" },
        "totalHours": { "type": "number" },
        "language": { "type": "string", "maxLength": 10 },
        "activeCourseId": { "type": "string", "maxLength": 100 },
        "activeLessonId": { "type": "string", "maxLength": 100 },
        "activeExerciseId": { "type": "string", "maxLength": 100 },
        "activeQuizId": { "type": "string", "maxLength": 100 },
        "completedLessons": { "type": "array" },
        "completedExercises": { "type": "array" },
        "completedArchitectureChallenges": { "type": "array" },
        "quizScores": { "type": "object" },
        "unlockedAchievements": { "type": "array" },
        "dailyGoalMinutes": { "type": "number" },
        "editorFontSize": { "type": "string", "maxLength": 10 },
        "soundEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "email", "xp", "level", "streak"]
    },
    "leaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public ranking card displaying XP, streak, tier, and badges",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "xp": { "type": "number" },
        "level": { "type": "string", "maxLength": 50 },
        "streak": { "type": "number" },
        "badgesCount": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "userId", "displayName", "xp", "level", "streak"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Private user account profile and learning records"
    },
    "/leaderboard/{userId}": {
      "schema": "leaderboardEntry",
      "description": "Aggregated leaderboard stats for public ranking"
    }
  }
}
