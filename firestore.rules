rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helper: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'xp', 'level', 'streak']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 150 &&
        data.xp is number && data.xp >= 0 &&
        ((data.level is string && data.level.size() <= 50) || (data.level is number && data.level >= 1)) &&
        data.streak is number && data.streak >= 0 &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
        (!('dailyGoalMinutes' in data) || (data.dailyGoalMinutes is number && data.dailyGoalMinutes >= 0 && data.dailyGoalMinutes <= 180)) &&
        (!('editorFontSize' in data) || (data.editorFontSize is string && data.editorFontSize.size() <= 10)) &&
        (!('soundEnabled' in data) || (data.soundEnabled is bool)) &&
        (!('streakActiveToday' in data) || (data.streakActiveToday is bool)) &&
        (!('totalHours' in data) || (data.totalHours is number && data.totalHours >= 0)) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 10)) &&
        (!('activeCourseId' in data) || (data.activeCourseId is string && data.activeCourseId.size() <= 100)) &&
        (!('activeLessonId' in data) || (data.activeLessonId is string && data.activeLessonId.size() <= 100)) &&
        (!('activeExerciseId' in data) || (data.activeExerciseId is string && data.activeExerciseId.size() <= 100)) &&
        (!('activeQuizId' in data) || (data.activeQuizId is string && data.activeQuizId.size() <= 100)) &&
        (!('completedLessons' in data) || (data.completedLessons is list && data.completedLessons.size() <= 500)) &&
        (!('completedExercises' in data) || (data.completedExercises is list && data.completedExercises.size() <= 500)) &&
        (!('completedArchitectureChallenges' in data) || (data.completedArchitectureChallenges is list && data.completedArchitectureChallenges.size() <= 100)) &&
        (!('unlockedAchievements' in data) || (data.unlockedAchievements is list && data.unlockedAchievements.size() <= 100)) &&
        (!('quizScores' in data) || (data.quizScores is map)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Validation Helper: LeaderboardEntry
    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'displayName', 'xp', 'level', 'streak']) &&
        data.id is string && data.id == request.auth.uid &&
        data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.xp is number && data.xp >= 0 &&
        ((data.level is string && data.level.size() <= 50) || (data.level is number && data.level >= 1)) &&
        data.streak is number && data.streak >= 0 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('badgesCount' in data) || (data.badgesCount is number && data.badgesCount >= 0)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Collection: User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
                    incoming().id == existing().id;
      allow delete: if isOwner(userId);
    }

    // Collection: Public Leaderboard
    match /leaderboard/{userId} {
      allow get, list: if true;
      allow create: if isOwner(userId) && isValidId(userId) && isValidLeaderboardEntry(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidLeaderboardEntry(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId;
      allow delete: if isOwner(userId);
    }
  }
}
